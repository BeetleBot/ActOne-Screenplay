# Maintainer: BeetleBot <nikarabilla@gmail.com>
pkgname=actone-bin
pkgver=0.1.0
pkgrel=1
pkgdesc="A modern screenwriting application (Binary)"
arch=('x86_64')
url="https://github.com/beetlebot/ActOne"
license=('GPL3')
provides=('actone')
conflicts=('actone')
source=("${pkgname}-${pkgver}.tar.gz::${url}/releases/download/v${pkgver}/ActOne-Linux-x64.tar.gz")
sha256sums=('SKIP')
package() {
  install -Dm755 "${srcdir}/actone" "${pkgdir}/usr/bin/actone"
  install -Dm644 "${srcdir}/actone.desktop" "${pkgdir}/usr/share/applications/actone.desktop"
  install -Dm644 "${srcdir}/actone-icon.png" "${pkgdir}/usr/share/icons/hicolor/256x256/apps/actone.png"
}
